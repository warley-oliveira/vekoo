#!/bin/bash -e

# jemalloc reduz o RSS do Puma e do Sidekiq de forma significativa numa VPS pequena.
if [ -z "${LD_PRELOAD+x}" ]; then
  LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
  export LD_PRELOAD
fi

# Só o container web prepara os bancos, e faz isso ANTES de o Thruster abrir a porta 80: o
# healthcheck do kamal-proxy só passa com tudo no lugar, e o Kamal só sobe worker e scripts depois
# desse healthcheck. É isso que fecha a janela de 500 entre "código novo" e "banco preparado".
#
#   db:mongoid:create_indexes  As agregações usam `hint`, e o Mongo recusa a consulta sem o índice.
#                              Vem primeiro: sem Mongo, o deploy para antes de migrar o Postgres.
#   db:prepare                 Cria o banco no primeiro boot e aplica as migrations nos demais.
#   platform:sync              Dado do produto, que a semente não carrega em produção.
#
# Uma invocação só, para um boot do Rails só. Se qualquer passo falhar, o `-e` mata o container: o
# healthcheck não passa, e a versão anterior continua no ar.
if [ "${*: -2:1}" == "./bin/rails" ] && [ "${*: -1:1}" == "server" ]; then
  ./bin/rails db:mongoid:create_indexes db:prepare platform:sync
fi

exec "${@}"
