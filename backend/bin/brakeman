#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# Sem o `--ensure-latest` do binstub padrão: com ele, cada versão nova do Brakeman faz
# `bin/ci` falhar (código 5) sem que o código tenha mudado. Atualizar a gem é decisão do
# Gemfile.lock, e o que este passo responde é só se o código tem aviso novo.
load Gem.bin_path("brakeman", "brakeman")
