# Kamal lê este arquivo a cada comando. Ele NÃO contém segredo nenhum: só aponta
# para variáveis do ambiente do shell (carregue com `set -a; . ./.env.deploy; set +a`
# a partir da raiz do monorepo).
#
# Por isso é seguro versionar. O que nunca pode ser versionado é o .env.deploy.

RAILS_MASTER_KEY=$RAILS_MASTER_KEY
SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Chave da Anthropic — o agente (criação por conversa e onboarding).
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# Quem pode criar conta antes do lançamento (e-mails separados por vírgula).
SIGNUP_ALLOWLIST=$SIGNUP_ALLOWLIST
GOOGLE_CREDENTIALS_BASE64=$GOOGLE_CREDENTIALS_BASE64
META_ACCESS_TOKEN=$META_ACCESS_TOKEN
META_APP_SECRET=$META_APP_SECRET
