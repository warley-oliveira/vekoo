# Kamal lê este arquivo a cada comando. Ele NÃO contém segredo nenhum: só aponta
# para variáveis do ambiente do shell (carregue com `set -a; . ./.env.deploy; set +a`
# a partir da raiz do monorepo) e para os arquivos PEM do certificado de origem.
#
# Por isso é seguro versionar. O que nunca pode ser versionado é o .env.deploy
# e o conteúdo de .kamal/certs/ — ambos estão no .gitignore.

REGISTRY_USER=$REGISTRY_USER
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

RAILS_MASTER_KEY=$RAILS_MASTER_KEY
SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Cloudflare Origin Certificate. Multilinha, então vem de arquivo — o parser de
# secrets do Kamal faz substituição de comando inline.
SSL_CERTIFICATE_PEM=$(cat .kamal/certs/syco.vekoo.app.pem)
SSL_PRIVATE_KEY_PEM=$(cat .kamal/certs/syco.vekoo.app.key)
