# Kamal lê este arquivo a cada comando. Ele NÃO contém segredo nenhum: só aponta
# para variáveis do ambiente do shell (carregue com `set -a; . ./.env.deploy; set +a`
# a partir da raiz do monorepo) e para os arquivos PEM do certificado de origem.
#
# Por isso é seguro versionar. O que nunca pode ser versionado é o .env.deploy
# e o conteúdo de .kamal/certs/ — ambos estão no .gitignore.
#
# Variável nova no deploy.yml entra aqui também, ou o Kamal recusa com "Secret not found". O que
# cada uma faz está em .env.deploy.example.

REGISTRY_USER=$REGISTRY_USER
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

RAILS_MASTER_KEY=$RAILS_MASTER_KEY
SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
MONGODB_URI=$MONGODB_URI
MONGO_INITDB_ROOT_PASSWORD=$MONGO_INITDB_ROOT_PASSWORD

ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
OPENAI_API_KEY=$OPENAI_API_KEY
OPENAI_ACCESS_TOKEN=$OPENAI_ACCESS_TOKEN

VAPID_PUBLIC_KEY=$VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=$VAPID_PRIVATE_KEY
VAPID_SUBJECT=$VAPID_SUBJECT

META_APP_ID=$META_APP_ID
META_APP_SECRET=$META_APP_SECRET
META_MESSAGING_VERIFY_TOKEN=$META_MESSAGING_VERIFY_TOKEN
INSTAGRAM_APP_ID=$INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=$INSTAGRAM_APP_SECRET
EVOLUTION_API_URL=$EVOLUTION_API_URL
EVOLUTION_API_KEY=$EVOLUTION_API_KEY
WHATSAPP_API_URL=$WHATSAPP_API_URL
WHATSAPP_API_KEY=$WHATSAPP_API_KEY
ZAPI_ACCOUNT_TOKEN=$ZAPI_ACCOUNT_TOKEN
ZAPI_CLIENT_TOKEN=$ZAPI_CLIENT_TOKEN

GOOGLE_CALENDAR_CLIENT_ID=$GOOGLE_CALENDAR_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=$GOOGLE_CALENDAR_CLIENT_SECRET
GOOGLE_SHEETS_CLIENT_ID=$GOOGLE_SHEETS_CLIENT_ID
GOOGLE_SHEETS_API_KEY=$GOOGLE_SHEETS_API_KEY
GOOGLE_SHEETS_APP_ID=$GOOGLE_SHEETS_APP_ID
GOOGLE_MAPS_API_KEY=$GOOGLE_MAPS_API_KEY
APIFY_API_TOKEN=$APIFY_API_TOKEN
MEDIA_PROXY_ALLOWED_HOSTS=$MEDIA_PROXY_ALLOWED_HOSTS

# Certificado de origem. Multilinha, então vem de arquivo — o parser de
# secrets do Kamal faz substituição de comando inline.
SSL_CERTIFICATE_PEM=$(cat .kamal/certs/syco.vekoo.app.pem)
SSL_PRIVATE_KEY_PEM=$(cat .kamal/certs/syco.vekoo.app.key)
