# secrets / env — nenhum .env* entra no git (cópias como .env.bak-* inclusive),
# só os exemplos sem valor. A chave do credentials também não.
.env
.env.*
!.env.example
!.env.deploy.example
backend/.env
backend/config/master.key
backend/config/credentials/*.key

# deploy (kamal)
.env.deploy
/backend/.kamal/certs/*.pem
/backend/.kamal/certs/*.key

# ruby / rails
/backend/tmp/
/backend/log/
/backend/storage/
/backend/.bundle/
/backend/coverage/

# node / vite
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/

# os / editor
.DS_Store
*.log
