# Copie para .env.deploy (gitignorado) e preencha. O Kamal lê estas variáveis do
# AMBIENTE DO SHELL, por isso o `set -a` antes de qualquer comando:
#
#   set -a; . ./.env.deploy; set +a
#   cd backend && kamal deploy
#
# Gere os valores assim:
#   SECRET_KEY_BASE   -> cd backend && bin/rails secret
#   RAILS_MASTER_KEY  -> cat backend/config/master.key
#   POSTGRES_PASSWORD -> openssl rand -hex 24

# --- registry (GHCR) -------------------------------------------------------
# Usuário do GitHub dono do repositório. O nome do repositório Docker é
# derivado em minúscula automaticamente (deploy.yml usa .downcase).
REGISTRY_USER=AndreMatheus29
# Personal Access Token (classic) com escopo write:packages e read:packages.
# github.com/settings/tokens -> Generate new token (classic)
KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- rails -----------------------------------------------------------------
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# --- banco -----------------------------------------------------------------
# A senha precisa ser a MESMA nas duas variáveis: o accessory `db` inicializa o
# Postgres com POSTGRES_PASSWORD e o app se conecta pela DATABASE_URL.
POSTGRES_PASSWORD=
# O host é o NOME DO CONTAINER do accessory (rede docker `kamal`), não localhost.
DATABASE_URL=postgres://vekoo:SENHA_IGUAL_A_POSTGRES_PASSWORD@vekoo-api-db:5432/vekoo_production
