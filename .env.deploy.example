# Copie para .env.deploy (gitignorado) e preencha. O Kamal lê estas variáveis do AMBIENTE DO SHELL,
# por isso o `set -a` antes de qualquer comando:
#
#   set -a; . ./.env.deploy; set +a
#   cd backend && kamal deploy
#
# Gere os valores assim:
#   SECRET_KEY_BASE                -> cd backend && bin/rails secret
#   RAILS_MASTER_KEY               -> cat backend/config/master.key
#   POSTGRES_PASSWORD              -> openssl rand -hex 24
#   MONGO_INITDB_ROOT_PASSWORD     -> openssl rand -hex 24
#   VAPID_PUBLIC_KEY, _PRIVATE_KEY -> cd backend && bin/rails runner 'k = WebPush.generate_key; puts k.public_key, k.private_key'
#
# Até o bloco "Bancos", é obrigatório: sem isso a API não sobe. Daí em diante, cada recurso desliga
# sozinho sem a chave, e o comentário diz o que para. Variável nova entra também em
# backend/config/deploy.yml e backend/.kamal/secrets.
#
# O que é só endereço (BACKEND_URL, APP_HOSTS, FRONTEND_ORIGINS, GOOGLE_CALENDAR_REDIRECT_URI, os
# WIDGET_*, os do Redis) fica em `env.clear`, no próprio deploy.yml.

# --- Registry (GHCR) -----------------------------------------------------------
# Dono do token. O nome do repositório Docker é derivado em minúscula (deploy.yml usa .downcase):
# a imagem vai para ghcr.io/warley-oliveira/vekoo-api.
REGISTRY_USER=warley-oliveira
# Personal Access Token CLASSIC com write:packages e read:packages. Um fine-grained faz login e falha
# no push. github.com/settings/tokens -> Generate new token (classic)
KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Rails ---------------------------------------------------------------------
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
# Sal do hashid da URL do front (/a/<hashid>/...) e do cabeçalho X-Account. Vazio, vale o padrão do
# código. Trocar depois quebra todo link já guardado (avisos, push, favoritos): defina uma vez.
HASHID_SALT=

# --- Bancos --------------------------------------------------------------------
# A senha precisa ser a MESMA nas duas variáveis: o accessory `db` inicializa o Postgres com
# POSTGRES_PASSWORD e o app se conecta pela DATABASE_URL. O host é o NOME DO CONTAINER do accessory
# (rede docker `kamal`), não localhost.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://vekoo:SENHA_IGUAL_A_POSTGRES_PASSWORD@vekoo-api-db:5432/vekoo_production
# Idem para o Mongo. Sem ela, o boot falha já nos índices, e o deploy volta para a versão anterior.
# A senha só vale na criação do volume: trocar depois pede `db.changeUserPassword`.
MONGO_INITDB_ROOT_PASSWORD=
MONGODB_URI=mongodb://vekoo:SENHA_IGUAL_A_MONGO_INITDB_ROOT_PASSWORD@vekoo-api-mongodb:27017/vekoo_production?authSource=admin

# --- Inteligência artificial ---------------------------------------------------
# Claude: geração de carrossel, copiloto, resposta sugerida, blocos de IA dos fluxos e lembretes com
# `aiPrompt`. Sem ela, esses recursos respondem que não estão disponíveis e não cobram crédito.
ANTHROPIC_API_KEY=
# OpenAI tem DUAS variáveis, porque dois domínios vieram de lugares diferentes. Podem ter a mesma chave.
# Busca semântica do catálogo. Sem ela, o catálogo funciona inteiro e busca só por texto. Ao colocar,
# o job recorrente alcança o que já existe, 5 mil itens por hora.
OPENAI_API_KEY=
# Transcrição de áudio (Whisper). Sem ela, o áudio fica sem transcrição e o bloco
# `ai_audio_transcription` sai por `onError`.
OPENAI_ACCESS_TOKEN=

# --- Notificação push (PWA) ----------------------------------------------------
# Sem as três, a opção some da tela e os avisos continuam só dentro do app. Trocar as chaves
# depois invalida os dispositivos já inscritos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:alguem@exemplo.com.br, exigido pelos serviços de push.
VAPID_SUBJECT=

# --- Canais: Meta --------------------------------------------------------------
# App da Meta (WhatsApp oficial, Messenger e a Business Discovery da curadoria). O META_APP_ID é público
# e fica no env.clear do deploy.yml; aqui só como referência. Sem ele, conectar esses canais falha. O segredo também
# confere a assinatura dos webhooks: com META_APP_SECRET e INSTAGRAM_APP_SECRET vazios, a API não tem
# o que conferir e aceita o webhook de qualquer um. Conectou canal da Meta, preencha.
META_APP_ID=
META_APP_SECRET=
# App do Instagram Login, que é outro. Sem ele, conectar o Instagram falha.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Desafio do webhook de Instagram e Messenger: invente um, e cole o mesmo no painel da Meta. Sem ele,
# a Meta não consegue validar a URL.
META_MESSAGING_VERIFY_TOKEN=

# --- Canais: WhatsApp não oficial ----------------------------------------------
# Evolution, o provedor padrão do WhatsApp Web. O servidor dela não sobe com este deploy: precisa
# estar no ar em outro lugar. Sem as duas, conectar por QR code falha.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Provedor Vekoo, alternativa à Evolution. Sem as duas, só ele para.
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# --- Google --------------------------------------------------------------------
# Google Agenda: Calendar API ligada, escopos calendar.app.created, openid e email. Sem elas, conectar
# responde `googleNotConfigured`, e o resto da agenda funciona.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Importar contatos do Google Sheets em campanhas: escopo drive.file e a origem da tela liberada no
# console. Sem CLIENT_ID, a opção fica indisponível. A API_KEY e o APP_ID são do Picker, na tela.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_APP_ID=
# `maps.*` nos scripts de cliente. Sem ela, essas chamadas devolvem erro ao script.
GOOGLE_MAPS_API_KEY=

# --- Campanhas e mídia ---------------------------------------------------------
# Busca de estabelecimentos (Apify). Sem ela, a opção fica indisponível. Para outro servidor, ponha
# APIFY_API_BASE no env.clear do deploy.yml (padrão: https://api.apify.com/v2).
APIFY_API_TOKEN=
# Hosts externos aceitos em /media/*, além da própria API, separados por vírgula. Precisa listar o
# CDN de mídia: host fora da lista dá erro no player de áudio do Safari, e só nele.
MEDIA_PROXY_ALLOWED_HOSTS=

# --- Cadastro --------------------------------------------------------------------
# Até o lançamento, só estes e-mails criam conta (separados por vírgula). Vazio ou ausente = ninguém.
# Quem já tem conta entra normalmente; o login não olha esta lista. Depois de mudar: `kamal app boot`
# (ou o próximo deploy).
SIGNUP_ALLOWLIST=

# --- Criação: imagens, embedding e curadoria --------------------------------------
# Vertex AI (Nano Banana e o embedding do banco de referências): a chave JSON da conta de serviço
# `vekoo-api-vertex`, em base64 (DEPLOY.md §2). Projeto e região ficam no env.clear do deploy.yml.
# Sem ela, a geração de imagem aparece como indisponível e os cards de referência publicam sem vetor.
GOOGLE_CREDENTIALS_BASE64=
# Token de usuário do sistema da Meta para a Business Discovery do Instagram (importação da curadoria,
# /admin/imports). O app é o mesmo META_APP_ID acima. Sem ele, a importação aparece como não configurada.
META_ACCESS_TOKEN=

# --- Só para tarefas de manutenção: não vão para o deploy.yml --------------------
# RAILS_LOG_LEVEL   Padrão: info. Para mudar, env.clear do deploy.yml.
# SEED_SOURCE=handwritten  Com SEED_DEMO_DATA=1, usa a semente escrita à mão em vez do retrato do banco
#                   de desenvolvimento (backend/db/seeds/snapshot/).
# SEED_DEMO_DATA=1  Cria a conta de demonstração e carrega as sementes de domínio em produção. Criam
#                   pessoas com senha conhecida: só num ambiente de demonstração.

# --- Front: NÃO vai para o Kamal --------------------------------------------------
# O front é compilado pela Cloudflare: estes valores vão em Settings -> Environment variables do
# projeto, e entram no bundle em tempo de build, portanto trocar exige novo build. Aqui ficam só
# como referência, e valem para quem compilar deste shell. Nada disto é segredo.
VITE_API_URL=https://syco.vekoo.app
NODE_VERSION=22
# App da Meta na tela, o mesmo META_APP_ID. Sem o id e o config da opção, ela aparece desabilitada,
# com aviso. CONFIG_ID é o Embedded Signup do WhatsApp oficial, e META_CONFIG_ID, o Facebook Login do
# Messenger.
VITE_FB_APP_ID=
VITE_FB_CONFIG_ID=
VITE_FB_META_CONFIG_ID=
# Versão do SDK da Meta. Padrão: v24.0.
VITE_FB_SDK_VERSION=
# O mesmo INSTAGRAM_APP_ID. Sem ele, a opção do Instagram aparece desabilitada, com aviso.
VITE_IG_APP_ID=
# Volta do Instagram Login. Padrão: a origem da tela + /auth/instagram/callback. Registre essa URL na Meta.
VITE_IG_REDIRECT_URI=
