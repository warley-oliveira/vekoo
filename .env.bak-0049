COMPOSE_PROJECT_NAME=vekoo_trimit
PORT_OFFSET=10
POSTGRES_PORT=5442
REDIS_PORT=6389
RAILS_PORT=3010
VITE_PORT=5183
POSTGRES_USER=vekoo_trimit
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vekoo_trimit_development
# DATABASE_URL is production-only: if set here it overrides database.yml in
# EVERY environment (tests would hit the development database).
REDIS_URL=redis://localhost:6389/0
VITE_API_URL=http://localhost:3010
# Public origin of this API (absolute ActiveStorage blob URLs in serializers)
API_ORIGIN=http://localhost:3010
FRONTEND_ORIGIN=http://localhost:5183
# User-space libvips root (dpkg -x extraction; see backend/lib/vips_userspace.rb)
VIPS_USERSPACE_ROOT=/home/tobots/.local/vips-root
# Agent (Fase 7)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-8
AGENT_MONTHLY_COST_CENTS_CAP=50000
RAILS_MAX_THREADS=10
