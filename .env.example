# Single knob per project. Derived ports:
#   POSTGRES_PORT = 5432 + PORT_OFFSET
#   REDIS_PORT    = 6379 + PORT_OFFSET
#   RAILS_PORT    = 3000 + PORT_OFFSET
#   VITE_PORT     = 5173 + PORT_OFFSET
# COMPOSE_PROJECT_NAME namespaces Docker network/containers/volumes so multiple
# projects can run at the same time. Never commit the real .env.

COMPOSE_PROJECT_NAME=my_project
PORT_OFFSET=10
POSTGRES_PORT=5442
REDIS_PORT=6389
RAILS_PORT=3010
VITE_PORT=5183
POSTGRES_USER=my_project
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_project_development
# DATABASE_URL is production-only: if set here it overrides database.yml in
# EVERY environment (tests would hit the development database).
REDIS_URL=redis://localhost:6389/0
VITE_API_URL=http://localhost:3010

# Geração por IA (backend). Sem ela os endpoints /ai/* respondem
# `failed` com log claro, sem cobrar crédito.
ANTHROPIC_API_KEY=
