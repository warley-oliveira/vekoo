# Single knob per project. Derived ports:
#   POSTGRES_PORT = 5432 + PORT_OFFSET
#   REDIS_PORT    = 6379 + PORT_OFFSET
#   RAILS_PORT    = 3000 + PORT_OFFSET
#   VITE_PORT     = 5173 + PORT_OFFSET
# COMPOSE_PROJECT_NAME namespaces Docker network/containers/volumes so multiple
# projects can run at the same time. Never commit the real .env.

COMPOSE_PROJECT_NAME=my_project
PORT_OFFSET=10
POSTGRES_PORT=5442
REDIS_PORT=6389
RAILS_PORT=3010
VITE_PORT=5183
POSTGRES_USER=my_project
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_project_development
# DATABASE_URL is production-only: if set here it overrides database.yml in
# EVERY environment (tests would hit the development database).
REDIS_URL=redis://localhost:6389/0
VITE_API_URL=http://localhost:3010

# Gerador de imagens (Nano Banana 2 no Vertex AI) — a aba "Imagens" e o "gerar"
# do seletor de imagem do editor. Sem chave de API: autentica por Application
# Default Credentials (`gcloud auth application-default login`). Sem isso, a
# geração aparece como indisponível e nada é cobrado. Modelo, tamanho e custo
# por imagem (micro-dólares, entra no teto mensal de OPEX junto com o agente)
# têm padrão no código. Teste: `cd backend && bin/rails images:smoke`.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K
# GEMINI_IMAGE_COST_MICRO_USD=67000

# Geração por IA (backend). Sem ela os endpoints /ai/* e a conversa de criação
# respondem `failed` com log claro, sem cobrar crédito.
ANTHROPIC_API_KEY=

# O modelo do agente de criação (/brands/:id/conversations). Padrão no código:
# claude-opus-5. A decisão é estruturada e curta; `claude-sonnet-5` corta o
# custo por geração pela metade se um dia o volume pedir.
AGENT_MODEL=claude-opus-5

# Teto mensal de custo de modelo por organização, em centavos de dólar. É
# controle de OPEX da Vekoo, não do cliente (esse vê créditos): ao bater,
# a conversa responde `costCapReached` sem chamar a API. 0 desliga.
AGENT_MONTHLY_COST_CENTS_CAP=0
