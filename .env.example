# Ambiente de desenvolvimento. `bin/setup` copia este arquivo para .env na primeira vez. É a fonte
# única: o Docker Compose lê direto, o back-end pelo link backend/.env e o Vite por `envDir`.
# Nunca comite o .env real. Produção tem outra lista: .env.deploy.example.
#
# Para subir basta o primeiro bloco. Todo o resto é opcional, e o recurso desliga sozinho sem a chave.

# --- Infraestrutura (obrigatório) ---------------------------------------------
# Um botão por projeto, para este rodar ao lado de outros na mesma máquina:
#   POSTGRES_PORT = 5432 + PORT_OFFSET    RAILS_PORT = 3000 + PORT_OFFSET
#   REDIS_PORT    = 6379 + PORT_OFFSET    VITE_PORT  = 5173 + PORT_OFFSET
#   MONGO_PORT    = 27017 + PORT_OFFSET
# COMPOSE_PROJECT_NAME separa rede, containers e volumes do Docker.
COMPOSE_PROJECT_NAME=vekoo
PORT_OFFSET=40
POSTGRES_PORT=5472
REDIS_PORT=6419
RAILS_PORT=3040
VITE_PORT=5213
MONGO_PORT=27057
POSTGRES_USER=vekoo
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vekoo_development
MONGO_DB=vekoo_development
REDIS_URL=redis://localhost:6419/0
VITE_API_URL=http://localhost:3040
# DATABASE_URL e MONGODB_URI são só de produção. Definida aqui, DATABASE_URL vale em TODOS os
# ambientes e as specs passariam a rodar no banco de desenvolvimento.

# --- Inteligência artificial --------------------------------------------------
# Claude: geração de carrossel, copiloto, resposta sugerida, blocos de IA dos fluxos e lembretes
# com `aiPrompt`. Sem ela, esses recursos respondem que não estão disponíveis e não cobram crédito.
ANTHROPIC_API_KEY=
# OpenAI tem DUAS variáveis, porque dois domínios vieram de lugares diferentes. Podem ter a mesma chave.
# Busca semântica do catálogo. Sem ela, o catálogo funciona inteiro e busca só por texto.
OPENAI_API_KEY=
# Transcrição de áudio (Whisper). Sem ela, o áudio fica sem transcrição e o bloco
# `ai_audio_transcription` sai por `onError`.
OPENAI_ACCESS_TOKEN=

# --- Notificação push (PWA) ---------------------------------------------------
# Gere com: cd backend && bin/rails runner 'k = WebPush.generate_key; puts k.public_key, k.private_key'
# Sem as três, a opção some da tela e os avisos continuam só dentro do app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:alguem@exemplo.com.br, exigido pelos serviços de push.
VAPID_SUBJECT=

# --- Canais: Meta ---------------------------------------------------------------
# App da Meta (WhatsApp oficial e Messenger). Sem ele, conectar esses canais falha, e a tela já avisa
# se faltarem os VITE_FB_* abaixo. O segredo também confere a assinatura dos webhooks.
META_APP_ID=
META_APP_SECRET=
# App do Instagram Login, que é outro. Sem ele, conectar o Instagram falha.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Desafio do webhook de Instagram e Messenger. Sem ele, a Meta não consegue validar a URL.
META_MESSAGING_VERIFY_TOKEN=
# O mesmo do lado da tela. Sem eles, as opções da Meta aparecem desabilitadas, com aviso.
VITE_FB_APP_ID=
VITE_FB_CONFIG_ID=
VITE_FB_META_CONFIG_ID=
VITE_IG_APP_ID=

# --- Canais: WhatsApp não oficial -----------------------------------------------
# Evolution, o provedor padrão do WhatsApp Web. Sem a chave, conectar por QR code falha.
EVOLUTION_API_KEY=
# Provedor AIVA, alternativa à Evolution. Sem a chave, só ele para.
WHATSAPP_API_KEY=

# --- Google ---------------------------------------------------------------------
# Google Agenda. Sem elas, conectar responde `googleNotConfigured`, e o resto da agenda funciona.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Rota da tela que recebe a volta do login, registrada no Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5213/calendar/google-callback
# Importar contatos do Google Sheets em campanhas. Sem CLIENT_ID, a opção fica indisponível.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_APP_ID=
# `maps.*` nos scripts de cliente. Sem ela, essas chamadas devolvem erro ao script.
GOOGLE_MAPS_API_KEY=

# --- Campanhas ------------------------------------------------------------------
# Busca de estabelecimentos (Apify). Sem ela, a opção fica indisponível.
APIFY_API_TOKEN=

# --- Com valor padrão: descomente só para mudar ----------------------------------
# Ficam comentadas de propósito: `ENV.fetch` devolve o texto vazio de uma linha `X=`, e o padrão
# deixaria de valer.
#
# URL pública da API, que provedores precisam alcançar: webhooks e mídia. Em desenvolvimento, só
# recebe webhook de verdade com um túnel. Padrão: http://localhost:$RAILS_PORT.
# BACKEND_URL=https://meu-tunel.exemplo.com.br
# Origens liberadas no CORS e no /cable, separadas por vírgula. Padrão: o Vite, em $VITE_PORT.
# FRONTEND_ORIGIN, no singular, é o nome antigo e ainda vale, se FRONTEND_ORIGINS não existir.
# FRONTEND_ORIGINS=http://localhost:5213
# Threads e processos do Puma. Padrão: 3 threads, um processo.
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=0
# Bancos do Redis para pub/sub do ActionCable e cache. Padrão: $REDIS_URL nos bancos 1 e 2.
# CABLE_REDIS_URL=redis://localhost:6419/1
# CACHE_REDIS_URL=redis://localhost:6419/2
# Hosts dos bancos, se não estiverem nesta máquina. Padrão: localhost.
# POSTGRES_HOST=localhost
# MONGO_HOST=localhost
# Servidores dos provedores. Padrão: http://localhost:8089 e http://localhost:8080.
# EVOLUTION_API_URL=http://localhost:8089
# WHATSAPP_API_URL=http://localhost:8080
# Provedor de um WhatsApp Web novo: evolution_api (padrão) ou aiva_api.
# WHATSAPP_WEB_DEFAULT_PROVIDER=evolution_api
# Hosts externos aceitos em /media/*, separados por vírgula. Fora da lista, o áudio não toca no Safari.
# MEDIA_PROXY_ALLOWED_HOSTS=cdn.exemplo.com.br
# Outro servidor para a Apify. Padrão: https://api.apify.com/v2.
# APIFY_API_BASE=https://api.apify.com/v2
# De onde o snippet do widget carrega o script e com quem fala. Padrão: widget.vekoo.app e $BACKEND_URL.
# WIDGET_BASE_URL=https://widget.vekoo.app
# WIDGET_API_BASE_URL=http://localhost:3040
# WIDGET_ASSETS_BASE_URL=http://localhost:3040
# Versão do SDK da Meta na tela (padrão v24.0) e volta do Instagram Login (padrão: a origem da tela
# + /auth/instagram/callback).
# VITE_FB_SDK_VERSION=v24.0
# VITE_IG_REDIRECT_URI=http://localhost:5213/auth/instagram/callback
# Sufixo do banco de teste, para rodar specs em paralelo (cada worktree tem o seu).
# TEST_ENV_NUMBER=1
#
# O código também lê, mas ninguém precisa pôr aqui: PORT e PIDFILE (Puma), CI e WIDGET_THROTTLE_TESTS
# (specs), MONTHS e DRY_RUN (tarefa chats:*), SEED_DEMO_DATA e RAILS_LOG_LEVEL (só produção).
