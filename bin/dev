#!/usr/bin/env bash
# Todo dia: bancos, o que chegou no último git pull, e os quatro processos de Procfile.dev
# (API, Sidekiq, Sidekiq de scripts e Vite). Da primeira vez, bin/setup.
set -euo pipefail
cd "$(dirname "$0")/.."

[ -f .env ] || { echo "Sem .env. Rode bin/setup primeiro."; exit 1; }
set -a; . ./.env; set +a

echo "==> infra (postgres + mongodb + redis)"
docker compose up -d --wait

# Migration nova e índice novo. Sem o índice, o Mongo recusa a agregação que usa `hint`, e o erro
# só aparece na tela que a usa.
echo "==> índices do Mongo e migrations"
( cd backend && bin/rails db:mongoid:create_indexes db:prepare )

if command -v overmind >/dev/null 2>&1; then
  exec overmind start -f Procfile.dev
elif command -v foreman >/dev/null 2>&1; then
  exec foreman start -f Procfile.dev
else
  echo "Nem overmind nem foreman estão instalados."
  echo "  gem install foreman        # o mais simples"
  echo "  # ou overmind (precisa de tmux): https://github.com/DarthSim/overmind"
  echo
  echo "Ou rode cada processo no próprio terminal:"
  echo "  cd backend  && bundle exec rails server -p ${RAILS_PORT:-3000}"
  echo "  cd backend  && bundle exec sidekiq -C config/sidekiq.yml"
  echo "  cd backend  && bundle exec sidekiq -C config/sidekiq_scripts.yml"
  echo "  cd frontend && npm run dev"
  exit 1
fi
