#!/usr/bin/env bash
# Sobe o ambiente de desenvolvimento do zero: .env, Postgres + Mongo + Redis, dependências,
# índices, banco e semente. Idempotente: rode de novo quando quiser. Depois dele, todo dia: bin/dev.
set -euo pipefail
cd "$(dirname "$0")/.."

for tool in docker bundle npm; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "Falta o comando '$tool'. Versões de Ruby e Node em .tool-versions; Docker com Compose v2."
    exit 1
  }
done

# O .env é a fonte única: o back-end lê pelo link, o Vite por `envDir`.
if [ ! -f .env ]; then
  cp .env.example .env
  echo "==> .env criado a partir de .env.example (o que cada chave opcional liga está explicado lá)"
fi
ln -sfn ../.env backend/.env

set -a; . ./.env; set +a

echo "==> infra (postgres + mongodb + redis)"
docker compose up -d --wait

echo "==> dependências do back-end"
( cd backend && { bundle check >/dev/null 2>&1 || bundle install; } )

echo "==> dependências do front-end"
( cd frontend && npm install )

# Índices antes do banco, como no bin/docker-entrypoint: a semente de um banco vazio já consulta, e o
# Mongo recusa `hint` sem o índice. db:prepare cria o banco, aplica migrations e, se o banco nasceu
# agora, carrega a semente.
echo "==> índices do Mongo, banco e semente"
( cd backend && bin/rails db:mongoid:create_indexes db:prepare )

cat <<DONE

Pronto. Para subir tudo: bin/dev
  API  http://localhost:${RAILS_PORT:-3000}
  Tela http://localhost:${VITE_PORT:-5173}  (marina.duarte@exemplo.com.br / carrossel123)

A semente só roda sozinha em banco novo. Para carregar de novo: cd backend && bin/rails db:seed
DONE
