# Cabeçalhos do Cloudflare Pages.
#
# Diferente do nginx, aqui as regras se ACUMULAM: um bloco mais específico não
# descarta os cabeçalhos do bloco /* — não existe a armadilha de herança do
# `add_header`.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # O microfone é do próprio app: o chat grava áudio.
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), interest-cohort=()
  # connect-src libera só a API do Vekoo, em HTTP e no WebSocket do ActionCable. Se
  # aparecer erro de CSP no console ao integrar algo novo (analytics, fonte externa), é
  # aqui que se ajusta.
  #
  # Atenção ao ligar o decoder Opus do chat (áudio no Safari/iOS): ele compila WASM e
  # sobe um worker de blob, então vai precisar de 'wasm-unsafe-eval' em script-src e de
  # blob: em worker-src. Sem isso, falha só aqui em produção: em desenvolvimento não há
  # CSP.
  #
  # Conectar um canal pela Meta (WhatsApp oficial e Messenger) usa o SDK dela, que entra
  # sob demanda, só nessa tela. É o que cada origem libera:
  # - script-src connect.facebook.net: o próprio SDK (sdk.js e o pacote para onde ele
  #   redireciona). Sem isso, o botão de conectar nem chega a funcionar.
  # - connect-src www e web.facebook.com: as chamadas que o SDK faz durante o login. O
  #   `web.` é o endereço que a Meta usa em algumas regiões, como já conferia a origem.
  # - frame-src www e web.facebook.com: os iframes que o SDK pode abrir na própria página.
  #   'self' fica porque, sem frame-src, valia o default-src.
  # A janela de login da Meta e a do Instagram são janelas de verdade: a CSP desta página
  # não as alcança, e o Instagram Login não precisa de nada aqui. As imagens já passam por
  # img-src https:, e o QR code, por data:.
  # frame-src da API: a prévia de PDF dos anexos abre o arquivo num iframe.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' https: blob:; connect-src 'self' https://syco.vekoo.app wss://syco.vekoo.app https://www.facebook.com https://web.facebook.com; frame-src 'self' https://www.facebook.com https://web.facebook.com https://syco.vekoo.app; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Arquivos com hash no nome — imutáveis por definição.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O HTML nunca pode ser cacheado, senão um deploy novo continua servindo o
# index.html velho, que aponta para bundles que não existem mais.
/index.html
  Cache-Control: no-cache

# Idem para o service worker e o manifesto: é por eles que o navegador descobre que
# saiu uma versão nova.
/sw.js
  Cache-Control: no-cache

/sw-push.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
